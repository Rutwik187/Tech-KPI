# Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3100
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_ADMIN_OBJECT_ID=
CRON_SECRET=GENERATE_A_RANDOM_CRON_SECRET
WORKLOAD_SECRET=GENERATE_A_RANDOM_FUNCTION_SECRET
# Populated by npm run neon:deploy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_FUNCTION_WORKLOAD_BASE_URL=
# Optional: requires a paid Neon plan
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
